      "volume_mb": "evidence_access_volume > 55.0",
      "failed_logins": "failed_login_count >= 2"
    },
    "preprocessing": {
      "log1p_features": [
        "failed_login_count",
        "evidence_access_volume",
        "case_access_pattern",
