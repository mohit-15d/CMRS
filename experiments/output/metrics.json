{
  "experiment": "CMRS Section 4.5 - anomaly detection on synthetic user sessions",
  "critical_note": "All values below are measured from the actual binary predictions of the listed detectors. No value was forced, adjusted, or targeted.",
  "protocol": {
    "primary_model_seed": 42,
