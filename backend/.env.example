# ============================================================
# CMRS - Chain-of-Custody Management & Reporting System
# Environment Variable Template
#
# To set up your real environment:
#   1. Copy this file to .env
#      (Windows:  copy .env.example .env)
#   2. Fill in REAL secret values below.
#   3. NEVER commit .env to version control.
#
# Every value below is a PLACEHOLDER - do not use these in a
# real deployment. CMRS is an academic/demonstration system:
# it is TAMPER-EVIDENT, not tamper-proof.
# ============================================================

# ---------- Application ----------
APP_NAME=CMRS
APP_ENV=development
DEBUG=false
# Port that uvicorn listens on
PORT=8000
# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173

# ---------- Database (PostgreSQL) ----------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# CMRS uses PostgreSQL ONLY. Never use SQLite.
DATABASE_URL=postgresql+psycopg://cmrs_user:CHANGE_ME@localhost:5432/cmrs_db

# ---------- JWT Authentication ----------
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
# Token lifetime in minutes (e.g. 60 = 1 hour)
JWT_EXPIRE_MINUTES=60
# JWT algorithm. Keep as HS256 unless you know what you are doing.
JWT_ALGORITHM=HS256

# ---------- Login rate limiting / lockout ----------
# Per-IP request throttle on /api/auth/login.
LOGIN_RATELIMIT_MAX=10
LOGIN_RATELIMIT_WINDOW_SECONDS=60
# Per-(IP, username) failure lockout (returns 429 until the window elapses).
LOGIN_LOCKOUT_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# ---------- Admin Bootstrap (first user) ----------
# Used only on startup to create the initial admin user when the username does
# not already exist. Leave unset to skip. Values are never logged.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_FULL_NAME=System Administrator

# ---------- Evidence Encryption (AES-256-GCM) ----------
# 32-byte key, represented as 64 hexadecimal characters. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS

# ---------- Evidence Storage ----------
# Directory where encrypted evidence files are stored (outside the DB).
# Use an absolute path or a path relative to the backend directory.
EVIDENCE_STORAGE_DIR=./data/evidence

# ---------- Logging ----------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO